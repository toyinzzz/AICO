{
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_CONNECTION_STRING}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "AICO",
    "Audience": "AICO-Users",
    "ExpiryInMinutes": 60
  },
  "ExternalServices": {
    "OpenAI": {
      "ApiKey": "${OPENAI_API_KEY}",
      "BaseUrl": "https://api.openai.com/v1"
    },
    "AIService": {
      "BaseUrl": "${AI_SERVICE_URL}"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "${FRONTEND_URL}",
      "https://${DOMAIN_NAME}"
    ]
  }
}